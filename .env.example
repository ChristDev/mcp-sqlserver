# MCP SQL Server — Environment Variables
# Use this for single-database mode (no TOML needed).
# For multi-database, use mcp-sqlserver.toml instead.

# Database connection string (ODBC format)
MCP_SQLSERVER_DSN=Driver={ODBC Driver 18 for SQL Server};Server=localhost,1433;Database=MyDatabase;UID=sa;PWD=YourPassword;Encrypt=yes;TrustServerCertificate=yes

# Guardrails
MCP_SQLSERVER_READONLY=false
MCP_SQLSERVER_MAX_ROWS=1000
MCP_SQLSERVER_QUERY_TIMEOUT=30

# Server
MCP_SQLSERVER_TRANSPORT_MODE=http
MCP_SQLSERVER_HOST=0.0.0.0
MCP_SQLSERVER_PORT=8002
MCP_SQLSERVER_LOG_LEVEL=INFO

# TOML config path (alternative to DSN above)
# MCP_SQLSERVER_CONFIG=/app/mcp-sqlserver.toml
